# Copy to .env, then run ./scripts/init-env.sh to fill the tokens.
# .env is git-ignored. Never commit real values.

# ---- Required -------------------------------------------------------------
# Model key. Hirelings speak to DeepSeek's OpenAI-compatible API by default.
DEEPSEEK_API_KEY=

# Front Desk tokens (random strings; ./scripts/init-env.sh writes them).
# The owner token orders hirelings and answers their decisions — keep it private.
FRONTDESK_OWNER_TOKEN=
# Shared by the hirelings of this box. Per-hireling tokens: FRONTDESK_TOKEN_<ID>.
FRONTDESK_AGENT_TOKEN=

# ---- Optional -------------------------------------------------------------
# Same model on OpenRouter when DeepSeek errors (429/5xx/401/403/404), per turn.
OPENROUTER_API_KEY=

# "Hands": the owner's accounts (GitHub, Google Drive, …) through Composio.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=hireling-tavern

# The quest: one shared goal every task declares how it moves.
GOAL_TITLE=
GOAL_TARGET=0
GOAL_CURRENCY=USD
GOAL_SOURCE=owner
GOAL_KINDS=revenue,leads,posts,videos,support
GOAL_PERIOD=

# Where this box runs (shown in the tavern as the server flag).
HIRELING_SERVER=local
HIRELING_REGION=

# Port of tavern-core on 127.0.0.1.
TAVERN_PORT=8080

# ---- Profile `brain` (the Tavern Ledger) ----------------------------------
# A git repo created from ledger/ (private is fine) and a token that can push to it.
LEDGER_REPO_URL=
LEDGER_GIT_TOKEN=
LEDGER_DB_PASSWORD=
GBRAIN_ADMIN_BOOTSTRAP_TOKEN=

# Compose profiles to turn on: full, test, brain (comma separated).
COMPOSE_PROFILES=
